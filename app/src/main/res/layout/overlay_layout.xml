<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/overlay_bg_shape"
    android:padding="14dp"
    android:gravity="center">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/dot_gold"
            android:layout_marginEnd="6dp"/>

        <TextView
            android:id="@+id/tvOverlayLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="XAU / USD"
            android:textColor="@color/gold_light"
            android:textSize="11sp"
            android:letterSpacing="0.08"
            android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvOverlayArrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▲"
            android:textColor="@color/price_up"
            android:textSize="12sp"
            android:layout_marginEnd="4dp"
            android:visibility="invisible"/>

        <TextView
            android:id="@+id/tvOverlayPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="@color/white"
            android:textSize="19sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvOverlayTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/gray_light"
        android:textSize="9sp"
        android:layout_marginTop="2dp"/>

    <ImageView
        android:id="@+id/btnClose"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginTop="6dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:alpha="0.5"/>

</LinearLayout>
